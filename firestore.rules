rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Admin check:
    // 1) First check a Firestore 'admins' collection with doc id == UID (recommended).
    // 2) Fallback to the hard-coded email allowlist for backwards compatibility.
    // For stronger security consider using Firebase custom claims set by an admin backend.
    function isAdmin() {
      let allowed = [
        'admin@bjlinksnews.com',
      ];
      // Prefer custom claim 'approved' + role checks, then admins collection, then email allowlist
      return isSignedIn() && (
        // token.approved claim (must be true)
        (request.auth.token.approved == true && request.auth.token.role == 'admin')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || email() in allowed
      );
    }

    function isValidSlug(s) {
      return s is string
        && s.size() > 0
        && s.size() <= 200
        && s.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    // ============================================================
    // Articles
    // ============================================================

    match /articles/{articleId} {
      // Published articles are public. Drafts/review require auth.
      allow read: if resource.data.status == 'published'
                  || isSignedIn();

      // Create: must be authenticated editor (email in allowlist)
      allow create: if isAdmin()
                    && request.resource.data.slug is string
                    && isValidSlug(request.resource.data.slug)
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 240
                    && request.resource.data.dek is string
                    && request.resource.data.dek.size() <= 600
                    && request.resource.data.category is string
                    && request.resource.data.category.size() > 0
                    && request.resource.data.category.size() <= 40
                    && request.resource.data.author is string
                    && request.resource.data.body is list
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 200
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 20
                    && request.resource.data.status in ['draft', 'review', 'published'];

      // Update: same constraints; only admins can publish
      allow update: if isAdmin()
                    && request.resource.data.slug is string
                    && isValidSlug(request.resource.data.slug)
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 240
                    && request.resource.data.dek is string
                    && request.resource.data.dek.size() <= 600
                    && request.resource.data.category is string
                    && request.resource.data.body is list
                    && request.resource.data.body.size() <= 200
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 20
                    && request.resource.data.status in ['draft', 'review', 'published'];

      // Delete: admin only
      allow delete: if isAdmin();

      // Sub-collection: comments (if added later)
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.author is string
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow update, delete: if request.auth.uid == resource.data.uid || isAdmin();
      }
    }

    // ============================================================
    // Categories
    // ============================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // Site Configuration
    // ============================================================
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // Pending approvals
    // ============================================================
    match /pendingUsers/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // Admins (roles set via Cloud Function / server SDK)
    // ============================================================
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ============================================================
    // Catch-all deny
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
