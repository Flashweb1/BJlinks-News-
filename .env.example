# ============================================================
# Bjlinks News — Environment Variables (EXAMPLE / TEMPLATE)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control (see .gitignore).
# VITE_ prefixed vars are exposed to the client bundle — only
# place public keys here, NEVER secrets.
# ============================================================

# Site (used for canonical URLs, OG tags, sitemap, email links)
VITE_SITE_NAME="Bjlinks News"
VITE_SITE_URL="https://bjlinksnews.com"
VITE_SITE_DESCRIPTION="Bjlinks News delivers premium journalism covering politics, business, technology, and more from Nigeria and around the world."
VITE_SITE_LOCALE="en_NG"
VITE_CONTACT_EMAIL="hello@bjlinksnews.com"

# Firebase Web SDK (public, safe to expose per Firebase docs)
# Copy values from Firebase Console → Project Settings → General → Your apps → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Admin access (comma-separated list of admin email addresses —
# combined with Firebase Security Rules to gate /admin writes)
VITE_ADMIN_EMAILS="admin@bjlinksnews.com"

# Analytics / Monitoring (optional, leave blank to disable)
VITE_PLAUSIBLE_DOMAIN=""
VITE_GA_MEASUREMENT_ID=""
VITE_SENTRY_DSN=""

# Compliance toggles
VITE_SHOW_COOKIE_BANNER="true"
